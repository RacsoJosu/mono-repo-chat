{
  "name": "@chatbot-whatsapp/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "desarrollo": "tsx watch src/server.ts",
    "compilar": "tsc -p tsconfig.json",
    "verificar": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.pruebas.json --noEmit && vitest run",
    "probar": "vitest run",
    "probar:observar": "vitest",
    "identidad:generar": "auth generate --config ./auth.config.ts --adapter drizzle --dialect postgresql --output ../../packages/base-datos/src/esquema/identidad.ts --yes",
    "bootstrap": "pnpm --filter @chatbot-whatsapp/base-datos compilar && tsx src/composicion/bootstrap.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.5",
    "@chatbot-whatsapp/base-datos": "workspace:*",
    "@chatbot-whatsapp/compartido": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/utils": "^0.4.2",
    "@types/pg": "^8.23.1",
    "auth": "1.7.5",
    "tsx": "^4.0.0",
    "vitest": "^5.0.0"
  }
}
