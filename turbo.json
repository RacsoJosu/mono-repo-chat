{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "desarrollo": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^compilar"],
      "passThroughEnv": [
        "ENTORNO",
        "PUERTO_API",
        "URL_BASE_DE_DATOS",
        "URL_PUBLICA",
        "SECRETO_AUTENTICACION"
      ]
    },
    "compilar": {
      "dependsOn": ["^compilar"],
      "outputs": ["dist/**"]
    },
    "verificar": {
      "dependsOn": ["^verificar"],
      "outputs": []
    },
    "probar": {
      "dependsOn": ["^compilar"],
      "outputs": []
    },
    "@chatbot-whatsapp/api#verificar": {
      "dependsOn": ["^verificar", "^compilar"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["URL_BASE_DE_DATOS_PRUEBAS"]
    },
    "@chatbot-whatsapp/api#probar": {
      "dependsOn": ["^compilar"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["URL_BASE_DE_DATOS_PRUEBAS"]
    }
  }
}
